# Copy to .env (gitignored). Secrets only — non-secrets live in config/config.yaml.

# Jellyfin API key (X-Emby-Token). Required for Catalogue Sync.
JELLYFIN_API_KEY=

# Brain client auth token (required when auth.mode is token).
# Chat clients send: Authorization: Bearer <value>
# MIMIR_AUTH_TOKEN is a deprecated alias — use MIMIR_CLIENT_TOKEN.
MIMIR_CLIENT_TOKEN=

# none | token (overrides config auth.mode). Restart brain after changing.
MIMIR_AUTH_MODE=token

# Voice (T-023 / T-027): set MIMIR_VOICE_ENABLED=false to skip STT/TTS on dev machines.
# Piper voice files are not secrets — run scripts/download_voice_models.ps1.
# MIMIR_VOICE_ENABLED=true
# MIMIR_VOICE_WARM_ON_START=true
# MIMIR_OLLAMA_KEEP_ALIVE=45m
# MIMIR_VOICE_STT_LANGUAGE_HINT=nl
# MIMIR_VOICE_TTS_LENGTH_SCALE=1.05
# Mic for voice_roundtrip.ps1 (ffmpeg dshow name; must match Windows Sound settings):
# MIMIR_VOICE_INPUT_DEVICE=Analogue 1 + 2 (Focusrite USB Audio)

# TUI mic icon: nerd (default, Nerd Font Mono in terminal) | text (ASCII mic/rec)
# MIMIR_TUI_ICON_MODE=nerd
# MIMIR_TUI_ICON_MODE=text

# Calendar feed(s). Tokenized share links are secrets.
# Single feed (legacy):
CALENDAR_ICS_URL=
# CALENDAR_ICS_USERNAME=
# CALENDAR_ICS_PASSWORD=
#
# Multiple named feeds (ids from config.yaml calendar.feeds):
# CALENDAR_ICS_URL_FAMILY=
# CALENDAR_ICS_URL_PERSONAL=
# Optional: CALENDAR_ICS_USERNAME_FAMILY= / CALENDAR_ICS_PASSWORD_FAMILY=

# BudgetTracker MCP (NAS SERVICE_TOKEN — same value in both places).
BUDGETTRACKER_TOKEN=
