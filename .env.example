# Mimir secrets — copy to `.env` (gitignored). Never commit real values.
# Loaded automatically by brain.config (python-dotenv); compose passes these too.

# Jellyfin API key — consumed by the Jellyfin sync in Phase 5.
JELLYFIN_API_KEY=

# Brain auth token — used when auth.mode=token (enforcement lands in Phase 7).
MIMIR_AUTH_TOKEN=
