# Copy to .env (gitignored). Secrets only — non-secrets live in config/config.yaml.

# Jellyfin API key (X-Emby-Token). Required for Catalogue Sync.
JELLYFIN_API_KEY=

# Auth token for the brain when auth.mode is token (required if runtime.host
# is not loopback — see docs/adr/0005-non-loopback-requires-auth-token.md).
# Chat clients send: Authorization: Bearer <value>
MIMIR_AUTH_TOKEN=

# Optional: none | token (overrides config auth.mode)
# MIMIR_AUTH_MODE=none

# Calendar feed(s). Tokenized share links are secrets.
# Single feed (legacy):
CALENDAR_ICS_URL=
# CALENDAR_ICS_USERNAME=
# CALENDAR_ICS_PASSWORD=
#
# Multiple named feeds (ids from config.yaml calendar.feeds):
# CALENDAR_ICS_URL_FAMILY=
# CALENDAR_ICS_URL_PERSONAL=
# Optional: CALENDAR_ICS_USERNAME_FAMILY= / CALENDAR_ICS_PASSWORD_FAMILY=
